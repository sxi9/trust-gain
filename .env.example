# TrustGain environment.
# When these are ABSENT, the app runs with built-in mock providers so you can
# develop the whole flow with no accounts. Swap in real keys to go live.

# --- Identity verification (licensed IDV; e.g. Stripe Identity) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...

# --- Escrow / payments (licensed; e.g. Stripe Connect) ---
# STRIPE_CONNECT_CLIENT_ID=ca_...

# --- Risk signals (disclosed; e.g. SEON) ---
# SEON_API_KEY=...

# Public base URL used to build invite links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
